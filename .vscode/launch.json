{
  "version": "0.2.0",
  "compounds": [
    {
      "name": "Angular Debug with npm start",
      "configurations": ["npm start", "Angular: Chrome"]
    }
  ],
  "configurations": [
    {
      "name": "npm start",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "npm",
      "args": ["start"],
      "console": "integratedTerminal"
    },
    {
      "name": "Angular: Chrome",
      "type": "chrome",
      "request": "launch",
      "url": "http://localhost:4200",
      "webRoot": "${workspaceFolder}",
      "sourceMapPathOverrides": {
        "webpack:///./*": "${webRoot}/*"
      }
    }
  ]
}
